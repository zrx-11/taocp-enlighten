    {
      "id": "q07",
      "chapterId": "ch03",
      "type": "blank",
      "question": "二进制 7 里有几个 1？（填数字）",
      "options": [],
      "answer": "3",
      "explain": "7 = 111，用 x&(x−1) 循环三次归零。"
    },
    {
