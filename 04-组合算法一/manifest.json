  "glossary": [
    {
      "term": "布尔函数",
      "def": "输入若干个 0 或 1、输出一个 0 或 1 的函数。",
      "chapterId": "ch01"
    },
    {
      "term": "真值表",
      "def": "把每种输入组合与对应输出列成一张表。",
      "chapterId": "ch01"
    },
    {
      "term": "极小项",
      "def": "每个变量恰好出现一次（或取反一次）的乘积项。",
      "chapterId": "ch01"
    },
    {
      "term": "析取范式",
      "def": "若干极小项相或得到的表达式。",
      "chapterId": "ch01"
    },
    {
      "term": "德摩根律",
      "def": "整体取反等于逐项取反再换与或。",
      "chapterId": "ch01"
    },
    {
      "term": "短路求值",
      "def": "与运算左边为假就不再算右边，或运算左边为真就不再算右边。",
      "chapterId": "ch02"
    },
    {
      "term": "位并行",
      "def": "把 64 个布尔值打包进一个字，一次运算同时处理 64 组输入。",
      "chapterId": "ch02"
    },
    {
      "term": "四 Russians 方法",
      "def": "把输入切成小块，预计算每块的所有取值结果，求值时查表拼接。",
      "chapterId": "ch02"
    },
    {
      "term": "总体计数",
      "def": "数一个二进制数里 1 的个数。",
      "chapterId": "ch03"
    },
    {
      "term": "二元决策图",
      "def": "按变量顺序分支、并合并相同子图的有向无环图，用来紧凑表示布尔函数。",
      "chapterId": "ch03"
    },
    {
      "term": "有序",
      "def": "BDD 中从根到叶的路径上变量出现顺序固定。",
      "chapterId": "ch03"
    },
    {
      "term": "归约",
      "def": "合并同构子图、删掉两个分支相同的节点。",
      "chapterId": "ch03"
    },
    {
      "term": "组合爆炸",
      "def": "可能情况的数量随规模指数增长，无法逐一枚举。",
      "chapterId": "ch04"
    },
    {
      "term": "回溯",
      "def": "走一步、不行就退回上一步换下一个选择的搜索方式。",
      "chapterId": "ch04"
    },
    {
      "term": "格雷码",
      "def": "相邻两个编码只差一位的二进制编码序列。",
      "chapterId": "ch04"
    },
    {
      "term": "字典序",
      "def": "按第一个不同位置的元素大小决定先后。",
      "chapterId": "ch04"
    }
  ],
