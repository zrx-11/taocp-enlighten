  "flashcards": [
    {
      "id": "f01",
      "chapterId": "ch01",
      "front": "n 变量布尔函数共有多少个？",
      "back": "2^(2^n) 个，因为 2^n 种输入、每种输出独立取 0/1。",
      "tags": [
        "布尔"
      ]
    },
    {
      "id": "f02",
      "chapterId": "ch01",
      "front": "析取范式怎么从真值表得到？",
      "back": "把输出为 1 的每一行写成一个极小项，再全部相或。",
      "tags": [
        "布尔"
      ]
    },
    {
      "id": "f03",
      "chapterId": "ch01",
      "front": "德摩根律的两条式子？",
      "back": "¬(a∧b)=¬a∨¬b；¬(a∨b)=¬a∧¬b。",
      "tags": [
        "布尔"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch02",
      "front": "短路求值的规则？",
      "back": "与运算左边为假即停；或运算左边为真即停，避免无意义的右侧求值。",
      "tags": [
        "求值"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch02",
      "front": "位并行求值的条件与上限？",
      "back": "各组完全独立、只含按位运算；一个 64 位字最多 64 组。",
      "tags": [
        "求值"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch02",
      "front": "四 Russians 方法的预计算与单次求值代价？",
      "back": "预计算约 (n/k)×2^k；单次求值约 n/k 次查表。",
      "tags": [
        "求值"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch03",
      "front": "x&(x−1) 做了什么？",
      "back": "清掉最低位的 1；循环次数等于 1 的个数。",
      "tags": [
        "位运算"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch03",
      "front": "BDD 的两条规则是什么？",
      "back": "有序（变量顺序固定）与归约（合并同构子图、删掉两分支相同的节点）。",
      "tags": [
        "决策图"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch03",
      "front": "为什么变量顺序会影响 BDD 大小？",
      "back": "顺序决定要保留多少未处理变量的组合路径；顺序差时中间组合无法合并，规模指数增长。",
      "tags": [
        "决策图"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch04",
      "front": "组合问题的五个类型？",
      "back": "存在、构造、计数、生成、优化。",
      "tags": [
        "生成"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch04",
      "front": "生成全部子集的两种方法？",
      "back": "二进制掩码从 0 数到 2^n−1；递归「选/不选」每个元素。",
      "tags": [
        "生成"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch04",
      "front": "回溯框架的四步？",
      "back": "判断是否完整、枚举候选、做选择后递归、撤销选择。",
      "tags": [
        "生成"
      ]
    }
  ]
}
